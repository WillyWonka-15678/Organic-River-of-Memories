{
  "name": "time-bullet-river",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-worker.mjs",
    "prebuild": "node scripts/build-worker.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets": "node scripts/prepare-assets.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "server": "node server/index.mjs",
    "test:server": "node --test server/test.mjs server/messages.test.mjs server/realtime.test.mjs server/admin.test.mjs server/exhibition.test.mjs",
    "messages:seed": "node server/seed.mjs",
    "messages:approve": "node server/approve.mjs",
    "admin:init": "node server/init-admin.mjs",
    "start": "node scripts/start.mjs",
    "qr": "node server/entry.mjs",
    "backup": "node server/backup.mjs",
    "restore": "node server/restore.mjs",
    "healthcheck": "node scripts/healthcheck.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "express": "^5.3.0",
    "lil-gui": "0.21.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
